POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog
# 운영: 공용 Postgres가 붙어 있는 외부 docker network 이름 (ADR-0008)
POSTGRES_NETWORK=postgres
DATABASE_URL="postgresql://blog:blog@localhost:5432/blog?schema=public"
# true면 공개 페이지가 DB 대신 src/mocks 데이터를 쓴다 (로컬 전용)
USE_MOCK_DATA=false

# Auth.js — GitHub OAuth App callback: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 관리자 GitHub 숫자 id (https://api.github.com/users/<login> 의 id)
ADMIN_GITHUB_ID=
# 리버스 프록시 뒤에서 필요
AUTH_TRUST_HOST=true
# 운영: 공개 주소. 없으면 standalone 서버가 바인딩 주소(0.0.0.0:3000)로 callback URL을 만든다
# AUTH_URL=https://devhimchan.com

# 공용 S3 저장소 — 운영은 Garage (ADR-0007, ADR-0009). 버킷과 키는 서버 관리자가 만들어 준다 — 관리자 키를 넣지 않는다
S3_URL=http://localhost:9000
S3_BUCKET=blog
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 운영: 공용 Garage가 붙어 있는 외부 docker network 이름
S3_NETWORK=garage
