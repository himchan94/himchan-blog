POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog
DATABASE_URL="postgresql://blog:blog@localhost:5432/blog?schema=public"
# true면 공개 페이지가 DB 대신 src/mocks 데이터를 쓴다 (로컬 전용)
USE_MOCK_DATA=false

# Auth.js — GitHub OAuth App callback: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 관리자 GitHub 숫자 id (https://api.github.com/users/<login> 의 id)
ADMIN_GITHUB_ID=
# 리버스 프록시 뒤에서 필요
AUTH_TRUST_HOST=true

# 공용 MinIO (ADR-0007). 버킷과 키는 서버 관리자가 만들어 준다 — root 키를 넣지 않는다
MINIO_URL=http://localhost:9000
MINIO_BUCKET=blog
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 운영: 공용 MinIO가 붙어 있는 외부 docker network 이름
MINIO_NETWORK=minio
