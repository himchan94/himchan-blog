POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog
DATABASE_URL="postgresql://blog:blog@localhost:5432/blog?schema=public"

# Auth.js — GitHub OAuth App callback: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 관리자 GitHub 숫자 id (https://api.github.com/users/<login> 의 id)
ADMIN_GITHUB_ID=
# 리버스 프록시 뒤에서 필요
AUTH_TRUST_HOST=true
